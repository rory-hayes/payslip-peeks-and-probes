# Optional public browser overrides. The production Lovable Cloud project has
# a reviewed low-privilege fallback in source so a missing host variable cannot
# publish a blank app. Never place secret or service-role keys in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Stripe publishable key only (`pk_test_` or `pk_live_`); it must match the
# server-side Stripe environment. Leave blank to deliberately disable checkout.
VITE_PAYMENTS_CLIENT_TOKEN=
# Set to true only after Google OAuth is configured in the same Supabase
# project and its exact production callback URLs have been tested. The button
# is deliberately hidden by default so customers never see an unverified path.
VITE_ENABLE_GOOGLE_OAUTH=false
# Optional, public Plausible site hostname (for example: payslipinsights.com).
# The browser only loads Plausible after an explicit non-essential-cookie opt-in.
VITE_PLAUSIBLE_DOMAIN=
