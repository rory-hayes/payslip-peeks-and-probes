# Browser Supabase client.
# Required for local dev and production frontend builds.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Lovable/Supabase project identifier used by the migrated project.
# Optional for the current Vite app, but present in local env files.
VITE_SUPABASE_PROJECT_ID=

# Stripe publishable/client token used by the embedded checkout UI.
# Required only when testing or running payments.
VITE_PAYMENTS_CLIENT_TOKEN=

# Supabase Edge Function runtime values.
# Set these in Supabase project secrets, not in the frontend bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lovable AI and Stripe connector gateway key.
# Required by payslip extraction and Lovable-routed Stripe calls.
LOVABLE_API_KEY=

# Stripe connector API keys for sandbox and live payments.
# Required by create-checkout, price lookup, portal, and cancellation functions.
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=

# Stripe webhook signing secrets.
# Required by the payments-webhook function.
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Optional future analytics provider.
# The current analytics layer is a no-op until a provider is wired.
VITE_POSTHOG_KEY=

# Optional Google Sheet command-centre sync.
# If these are not set, use the local command-centre CSV/JSON exports.
COMMAND_CENTRE_WEBHOOK_URL=
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
